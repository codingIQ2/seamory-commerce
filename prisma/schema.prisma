// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum InventoryMovementType {
  ORDER_DECREMENT
  ORDER_CANCEL_RESTORE
  ADMIN_ADJUSTMENT
  SEED
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String               @db.VarChar(80)
  email                String               @unique @db.VarChar(320)
  emailVerified        Boolean              @default(false)
  image                String?
  role                 UserRole             @default(MEMBER)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  sessions             Session[]
  accounts             Account[]
  addresses            Address[]
  cart                 Cart?
  orders               Order[]
  wishlistItems        WishlistItem[]
  inventoryMovements   InventoryMovement[]  @relation("InventoryActor")
  orderStatusHistories OrderStatusHistory[] @relation("OrderStatusActor")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String   @db.VarChar(40)
  recipient  String   @db.VarChar(80)
  phone      String   @db.VarChar(20)
  postalCode String   @db.VarChar(12)
  address1   String   @db.VarChar(240)
  address2   String?  @db.VarChar(240)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  products    Product[]
}

model Category {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(80)
  slug      String            @unique @db.VarChar(100)
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  products  ProductCategory[]
}

model Product {
  id            String            @id @default(uuid()) @db.Uuid
  brandId       String            @db.Uuid
  name          String            @db.VarChar(160)
  slug          String            @unique @db.VarChar(180)
  description   String
  material      String
  listPrice     Int
  salePrice     Int
  status        ProductStatus     @default(DRAFT)
  publishedAt   DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  brand         Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  categories    ProductCategory[]
  wishlistItems WishlistItem[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, salePrice])
  @@index([brandId, status, createdAt(sort: Desc)])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  alt       String   @db.VarChar(240)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
}

model ProductVariant {
  id                 String              @id @default(uuid()) @db.Uuid
  productId          String              @db.Uuid
  sku                String              @unique @db.VarChar(80)
  colorName          String              @db.VarChar(80)
  colorCode          String?             @db.VarChar(7)
  size               String              @db.VarChar(40)
  stock              Int                 @default(0)
  isActive           Boolean             @default(true)
  version            Int                 @default(0)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, colorName, size])
  @@index([productId, isActive])
  @@index([colorName, size, productId])
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model Cart {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String?    @unique @db.Uuid
  anonymousTokenHash String?    @unique
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  user               User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              CartItem[]
}

model CartItem {
  id           String         @id @default(uuid()) @db.Uuid
  cartId       String         @db.Uuid
  variantId    String         @db.Uuid
  quantity     Int
  priceAtAdded Int
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model WishlistItem {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

model Order {
  id                 String               @id @default(uuid()) @db.Uuid
  orderNo            String               @unique @db.VarChar(40)
  userId             String               @db.Uuid
  idempotencyKey     String               @db.VarChar(120)
  status             OrderStatus          @default(PENDING_PAYMENT)
  itemsAmount        Int
  discountAmount     Int                  @default(0)
  shippingAmount     Int                  @default(0)
  totalAmount        Int
  isTest             Boolean              @default(true)
  paidAt             DateTime?            @db.Timestamptz(3)
  cancelledAt        DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  address            OrderAddress?
  paymentAttempts    PaymentAttempt[]
  statusHistory      OrderStatusHistory[]
  inventoryMovements InventoryMovement[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model OrderItem {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @db.Uuid
  variantId     String         @db.Uuid
  productName   String         @db.VarChar(160)
  brandName     String         @db.VarChar(120)
  sku           String         @db.VarChar(80)
  colorName     String         @db.VarChar(80)
  size          String         @db.VarChar(40)
  listUnitPrice Int
  saleUnitPrice Int
  quantity      Int
  lineAmount    Int
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model OrderAddress {
  orderId    String  @id @db.Uuid
  recipient  String  @db.VarChar(80)
  phone      String  @db.VarChar(20)
  postalCode String  @db.VarChar(12)
  address1   String  @db.VarChar(240)
  address2   String? @db.VarChar(240)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model PaymentAttempt {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  provider    String        @default("TEST") @db.VarChar(30)
  providerRef String        @unique @db.VarChar(120)
  status      PaymentStatus @default(PENDING)
  amount      Int
  processedAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?      @db.Uuid
  reason      String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor       User?        @relation("OrderStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([actorUserId])
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  variantId     String                @db.Uuid
  type          InventoryMovementType
  quantityDelta Int
  stockBefore   Int
  stockAfter    Int
  orderId       String?               @db.Uuid
  actorUserId   String?               @db.Uuid
  reason        String
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  variant       ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor         User?                 @relation("InventoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId, type])
  @@index([variantId, createdAt(sort: Desc)])
  @@index([actorUserId])
}
